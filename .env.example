# Copy to .env.local and fill in. In CI these come from GitHub repo variables.

# Public (inlined into the static build)
NEXT_PUBLIC_SITE_URL=            # production origin, no trailing slash
NEXT_PUBLIC_CDN_URL=             # ImageKit images base, no trailing slash
NEXT_PUBLIC_CONTACT_EMAIL=       # shown on the site and in schema
NEXT_PUBLIC_EMAIL_FROM=          # Resend verified sender
NEXT_PUBLIC_NOTIFICATION_EMAIL=  # receives contact form submissions
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_LINKEDIN_URL=        # optional, schema.org sameAs
NEXT_PUBLIC_FACEBOOK_URL=        # optional, schema.org sameAs

# Server only (API routes)
CONTACT_NAME=                    # shown in the customer thank-you email
CONTACT_PHONE=
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
