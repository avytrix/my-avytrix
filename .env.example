# Copy to .env.local and fill in.
# GitHub: NEXT_PUBLIC_* are repo variables, everything else is a repo secret.

# Public (inlined into the static build)
NEXT_PUBLIC_SITE_URL=            # production origin, no trailing slash
NEXT_PUBLIC_SITE_NAME=           # brand name used in schema, Open Graph and legal pages
NEXT_PUBLIC_EMAIL_FROM_NAME=     # Resend sender display name
NEXT_PUBLIC_CDN_URL=             # ImageKit images base, no trailing slash
NEXT_PUBLIC_LOGO_URL=            # full logo image URL (header, footer, schema, emails)
NEXT_PUBLIC_CONTACT_EMAIL=       # shown on the site and in schema
NEXT_PUBLIC_EMAIL_FROM=          # Resend verified sender
NEXT_PUBLIC_NOTIFICATION_EMAIL=  # receives contact form submissions
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GITHUB_URL=          # optional; footer icon and schema.org sameAs
NEXT_PUBLIC_LINKEDIN_URL=        # optional; footer icon and schema.org sameAs
NEXT_PUBLIC_FACEBOOK_URL=        # optional; footer icon and schema.org sameAs
NEXT_PUBLIC_CONTACT_NAME=        # contact person on /contact and in emails
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT2_NAME=       # optional second contact on /contact
NEXT_PUBLIC_CONTACT2_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=     # optional; must match the Payoneer profile address
NEXT_PUBLIC_LEGAL_NAME=          # optional; legal entity operating the site
NEXT_PUBLIC_TAX_ID=              # optional; tax code (MST)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY= # ImageKit uploads only (unused by the site today)
NEXT_PUBLIC_CONTACT_API_URL=     # contact Worker endpoint, e.g. https://api.example.com/contact; form hidden if empty

# Contact Worker only (scripts/deploy-contact-worker.sh uploads these as Worker secrets)
CONTACT_WORKER_NAME=             # Cloudflare Worker name
CONTACT_TIMEZONE=                # IANA timezone for the team email timestamp, e.g. Asia/Ho_Chi_Minh
RECAPTCHA_SECRET_KEY=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IMAGEKIT_PRIVATE_KEY=            # never NEXT_PUBLIC_; ImageKit uploads only
